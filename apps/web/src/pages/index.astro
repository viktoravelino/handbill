---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro"
import { Content } from "../../../../README.md"
---

<!-- The landing page is the README: one source, so the two cannot drift. -->
<StarlightPage
  frontmatter={{
    title: "handbill",
    // The hero h1 stays "handbill"; the tab title and search snippet headline
    // say what it is, and the front page is a website, not an article.
    head: [
      {
        tag: "title",
        content: "handbill — publish one HTML file at an unguessable URL on your domain"
      },
      { tag: "meta", attrs: { property: "og:type", content: "website" } }
    ],
    template: "splash",
    hero: {
      tagline: "Hand someone a page.",
      actions: [
        { text: "Self-host in five steps", link: "/docs/self-hosting/", icon: "right-arrow" },
        {
          text: "npm i -g handbill",
          link: "https://www.npmjs.com/package/handbill",
          variant: "secondary"
        },
        {
          text: "GitHub",
          link: "https://github.com/viktoravelino/handbill",
          variant: "minimal",
          icon: "github"
        }
      ]
    }
  }}
>
  <Content />
</StarlightPage>
