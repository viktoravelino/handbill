{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "handbill",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // Pages are served from your own zone only; there is nothing to see on
  // workers.dev and a *.workers.dev hostname would classify as "nothing here".
  "workers_dev": false,
  "observability": { "enabled": true },

  "vars": {
    // EDIT 1 — your zone. Pages are served at https://<hash>.<ZONE>.
    "ZONE": "handbill.dev"
  },

  "routes": [
    // EDIT 2 — the API. Needs a proxied DNS record for `api`.
    { "pattern": "api.handbill.dev/*", "zone_name": "handbill.dev" },
    // EDIT 3 — the pages. Needs a proxied wildcard DNS record for `*`.
    { "pattern": "*.handbill.dev/*", "zone_name": "handbill.dev" }
  ],

  // EDIT 4 (optional) — living names. Create the namespace, paste the id it
  // prints, and uncomment the line; the trailing comma is part of it:
  //   bunx wrangler kv namespace create ALIASES
  // Without this binding the alias routes answer 404 and `<name>.<zone>` serves
  // nothing. Aliases are guessable by construction — see docs/SELF-HOSTING.md.
  // "kv_namespaces": [{ "binding": "ALIASES", "id": "<id>" }],

  // EDIT 5 (optional) — hosted accounts, instead of one
  // shared PUBLISH_TOKEN. With this binding the Worker mints a key per GitHub
  // account (POST /v1/keys) and /v1/health reports "mode": "accounts"; without
  // it those routes answer 404 and PUBLISH_TOKEN is unchanged. Removing the
  // binding again reverts the Worker to the token, every page still serving.
  //   bunx wrangler kv namespace create ACCOUNTS
  // One "kv_namespaces" array holds both bindings, so with EDIT 4 it reads
  // [{ "binding": "ALIASES", ... }, { "binding": "ACCOUNTS", ... }].
  //
  // The same namespace holds the per-owner page index and the quota counters:
  // with it a hosted account gets 25 pages a day and 250 MB stored, and without
  // it nothing is counted. Code-wise this is now complete; what is not yet in
  // place for a live zone is the terms, the abuse address and the drill (M17,
  // M18) — see docs/SELF-HOSTING.md "Hosted accounts" and docs/WAF.md.
  // "kv_namespaces": [{ "binding": "ACCOUNTS", "id": "<id>" }],

  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "handbill" }]

  // `PUBLISH_TOKEN` is a secret, never a var:
  //   openssl rand -hex 32 | wrangler secret put PUBLISH_TOKEN
  // `ADMIN_TOKEN` is a second, optional secret — the operator's takedown key,
  // never a user key. Without it `DELETE /v1/admin/pages/:hash` answers 404.
  // `MAX_BYTES` is optional and defaults to 5 MB.
}
