{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-console": "error",
    "no-redeclare": "off",
    "max-classes-per-file": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/test/**"],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "import/max-dependencies": "off"
      }
    },
    { "files": ["apps/worker/src/app.ts"], "rules": { "import/max-dependencies": "off" } }
  ],
  "ignorePatterns": ["dist", "node_modules", ".wrangler", ".astro", "docs"]
}
