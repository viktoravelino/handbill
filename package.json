{
  "name": "handbill-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --build && bun run --cwd apps/web check",
    "lint": "oxlint && oxfmt --check .",
    "format": "oxfmt .",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2"
  }
}
